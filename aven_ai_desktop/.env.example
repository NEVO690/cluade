# Development configuration for AVEN AI Desktop.
# Copy to ".env" next to main.py. It is read only when running from source;
# packaged builds never read .env files. Never commit your real .env.

# Provider: aven_cloud (default, no key), anthropic or openai
AVEN_PROVIDER=aven_cloud

# AVEN Cloud server (e.g. a local one started with: uvicorn server:app --port 8000)
# AVEN_CLOUD_URL=http://localhost:8000

# API keys - only needed for the anthropic / openai providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Selected AVEN model: aven-1 (default), aven-ultra, aven-core or aven-light
# AVEN_MODEL=aven-1

# Provider model behind each AVEN model (personal-key providers; Anthropic is pre-mapped)
# AVEN_1_MODEL=
# AVEN_ULTRA_MODEL=
# AVEN_CORE_MODEL=
# AVEN_LIGHT_MODEL=

# OpenAI-compatible server (optional). HTTPS required except for localhost.
# AVEN_BASE_URL=http://localhost:11434/v1

# Store data somewhere else (optional, e.g. for a portable or test setup)
# AVEN_DATA_DIR=C:\path\to\folder
