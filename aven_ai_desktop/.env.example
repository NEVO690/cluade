# Development configuration for AVEN AI Desktop.
# Copy to ".env" next to main.py. It is read only when running from source;
# packaged builds never read .env files. Never commit your real .env.

# Choose the provider: anthropic or openai
AVEN_PROVIDER=anthropic

# API keys (only the one for your provider is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models for each mode (optional - otherwise the values from Settings are used)
# AVEN_MODEL=claude-opus-5-5
# AVEN_CODE_MODEL=claude-opus-5-5

# OpenAI-compatible server (optional). HTTPS required except for localhost.
# AVEN_BASE_URL=http://localhost:11434/v1

# Store data somewhere else (optional, e.g. for a portable or test setup)
# AVEN_DATA_DIR=C:\path\to\folder
